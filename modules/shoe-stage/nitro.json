{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["shoestage"],
  "ios": {
    "iosModuleName": "ShoeStage"
  },
  "android": {
    "androidNamespace": ["shoestage"],
    "androidCxxLibName": "ShoeStage"
  },
  "autolinking": {
    "ShoeView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridShoeView"
      }
    },
    "DeviceGravity": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDeviceGravity"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
