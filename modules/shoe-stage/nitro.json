{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "shoestage"
  ],
  "ios": {
    "iosModuleName": "ShoeStage"
  },
  "android": {
    "androidNamespace": [
      "shoestage"
    ],
    "androidCxxLibName": "ShoeStage"
  },
  "autolinking": {
    "ShoeView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridShoeView"
      }
    },
    "DeviceGravity": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDeviceGravity"
      }
    },
    "PersonMatte": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPersonMatte"
      }
    },
    "SceneLight": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSceneLight"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
