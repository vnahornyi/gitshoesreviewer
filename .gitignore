# This is the library's ignore file. The example app has its own — Xcode, Gradle, Pods and the
# Ruby bundle all live under example/ and are ignored there.

.DS_Store
node_modules/
npm-debug.log
/coverage

# The keypoint models: 150 MB, rebuilt by tools/model-convert and research/foot-3d. `ios/README.md`
# says how to put them here.
model/

# The big local data: datasets, checkpoints, captured footage. Everything under assets/ except its
# README, which documents what each folder is and how to restore it. See assets/README.md.
assets/*
!assets/README.md

# Per-agent local setup: temporary plans, and the symlinks `npm run skills` creates so Claude Code
# finds the real, agent-neutral skills in skills/. Nothing in here is shared.
.claude/
