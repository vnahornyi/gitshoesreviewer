{
  "name": "react-native-shoe-tryon",
  "version": "0.1.0",
  "description": "Live 3D shoe try-on for React Native: foot keypoints, tracking and a 6-DoF shoe pose, entirely on device",
  "license": "UNLICENSED",
  "author": "Vladyslav Nahornyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vnahornyi/aishoesreviewer.git"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testPoints.ts",
    "ios",
    "nitrogen",
    "shoes",
    "model",
    "nitro.json",
    "ShoeTryOn.podspec",
    "react-native.config.js",
    "README.md"
  ],
  "scripts": {
    "codegen": "nitrogen --logLevel=warning",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "skills": "sh skills/link.sh",
    "example": "npm --prefix example run"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*",
    "react-native-vision-camera": "*",
    "react-native-worklets": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "nitrogen": "^0.37.1",
    "prettier": "2.8.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-vision-camera": "^5.2.3",
    "react-native-worklets": "^0.12.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
